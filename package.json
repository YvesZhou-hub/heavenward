{
  "name": "heavenward",
  "version": "0.3.1",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3210",
    "build": "next build",
    "start": "node scripts/serve-static.mjs 3210",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src tests scripts --max-warnings 0",
    "test": "vitest run",
    "validate:content": "vitest run tests/content.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "art:prepare": "tsx scripts/prepare-production-art.ts",
    "qa:simulate": "tsx scripts/simulate.ts",
    "qa:performance": "tsx scripts/performance.ts",
    "deploy:prepare": "node scripts/prepare-vercel.mjs",
    "deploy:record": "node scripts/record-deployment.mjs",
    "deploy:verify": "node scripts/verify-deployment.mjs https://heavenward.vercel.app"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.5",
    "sharp": "^0.35.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.0"
  }
}
